<Window x:Class="NekoTrends.App.AlertToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:NekoTrends.App.Converters"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Height" Width="330">

    <Window.Resources>
        <conv:PlatformBrushConverter x:Key="PlatformBrush" />
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentPinkBrush}"
            BorderThickness="1" CornerRadius="8" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="3" Opacity="0.55" />
        </Border.Effect>

        <StackPanel Margin="14,12">
            <Grid Margin="0,0,0,8">
                <TextBlock Text="NekoTrends" FontWeight="Bold" FontSize="12"
                           Foreground="{StaticResource AccentPinkBrush}" />
                <Button Content="✕" HorizontalAlignment="Right" Padding="6,0" FontSize="11"
                        Click="OnDismiss" />
            </Grid>

            <ItemsControl x:Name="AlertList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="5"
                                Padding="9,6" Margin="0,0,0,4" Cursor="Hand"
                                MouseLeftButtonUp="OnAlertClicked" Tag="{Binding Url}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" CornerRadius="2" Margin="0,0,9,0"
                                        Background="{Binding Platform, Converter={StaticResource PlatformBrush}}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding ChannelName}" FontWeight="Bold" FontSize="13" />
                                    <TextBlock Text="{Binding Message}" FontSize="11"
                                               Foreground="{StaticResource SurgeBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>

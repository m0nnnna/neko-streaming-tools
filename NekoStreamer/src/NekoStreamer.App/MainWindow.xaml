<Window x:Class="NekoStreamer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NekoStreamer.App.ViewModels"
        xmlns:conv="clr-namespace:NekoStreamer.App.Converters"
        mc:Ignorable="d"
        Title="NekoStreamer" Height="600" Width="820"
        Background="{StaticResource BgBrush}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
    </Window.Resources>
    <Grid Margin="12" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <!-- OBS ingest info -->
        <Border Grid.Row="0" Padding="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="OBS Server:" VerticalAlignment="Center" />
                <TextBox Text="{Binding IngestServerUrl, Mode=OneWay}" IsReadOnly="True" Width="180" Margin="6,0,20,0" VerticalAlignment="Center" />
                <TextBlock Text="OBS Stream Key:" VerticalAlignment="Center" />
                <TextBox Text="{Binding IngestStreamKey, Mode=OneWay}" IsReadOnly="True" Width="80" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Delay + start/stop -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Delay (seconds):" VerticalAlignment="Center" />
            <TextBox Text="{Binding DelaySeconds, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="6,0,20,0" VerticalAlignment="Center" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" />
            <Button Content="Start" Command="{Binding StartCommand}" Width="80" Margin="0,0,6,0" />
            <Button Content="Stop" Command="{Binding StopCommand}" Width="80" Margin="0,0,20,0" />
            <TextBlock Text="{Binding StatusText}" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Destinations -->
        <GroupBox Grid.Row="2" Header="Destinations" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Add Destination" Command="{Binding AddDestinationCommand}" Width="130" />
                    <TextBlock Text="Tip: picking Twitch/YouTube fills in the server URL. For Kick/X, hover the server field for where to copy it from."
                               Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Destinations}" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="{Binding IsRunning}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120" />
                        <DataGridTemplateColumn Header="Platform" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.AvailablePlatforms}"
                                              SelectedItem="{Binding Platform, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="RTMP Server URL" Binding="{Binding RtmpUrl}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding SetupHint}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Stream Key" Binding="{Binding StreamKey}" Width="200" />
                        <DataGridTemplateColumn Header="" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove"
                                            Command="{Binding DataContext.RemoveDestinationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <TextBlock Grid.Row="3" Text="Log" FontWeight="Bold" Margin="0,0,0,4" />
        <ListBox Grid.Row="4" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="11"
                 Background="{StaticResource SurfaceBrush}" />
    </Grid>
</Window>
